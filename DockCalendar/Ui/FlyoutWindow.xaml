<Window x:Class="DockCalendar.Ui.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock Calendar"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- A standard frame with the caption removed. The DWM backdrop is not drawn for WindowStyle="None". -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- One flat button template; the styles below only change colours and padding. -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="ButtonBase">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
                <Border x:Name="Overlay" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Hover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Pressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="FlatButton" TargetType="ButtonBase">
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        </Style>

        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="Padding" Value="14,6" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="DayButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
        </Style>

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="4" Padding="9,3" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Margin="2,2" CornerRadius="2" Background="{DynamicResource FgFaint}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,2" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="372" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: clock, mini month and agenda. Always visible. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1">
                    <Grid Margin="14,12,10,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ClockButton" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left" Padding="6,2" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock x:Name="ClockTime" FontSize="20" FontFamily="Segoe UI Variable Display, Segoe UI, Malgun Gothic" />
                                <TextBlock x:Name="ClockDate" Foreground="{DynamicResource Accent}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Month + agenda -->
                <Grid x:Name="CalendarPanel" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,10,10,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MonthTitle" Style="{StaticResource TitleButton}" HorizontalAlignment="Left" />
                        <Border Grid.Column="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="6"
                                Padding="1" Margin="0,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MonthSegment" Style="{StaticResource Segment}" GroupName="View" />
                                <RadioButton x:Name="WeekSegment" Style="{StaticResource Segment}" GroupName="View" />
                                <RadioButton x:Name="DaySegment" Style="{StaticResource Segment}" GroupName="View" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="PreviousMonth" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12" Width="28" />
                        <Button x:Name="NextMonth" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12" Width="28" />
                    </Grid>

                    <UniformGrid x:Name="WeekdayHeader" Grid.Row="1" Rows="1" Columns="7" Margin="12,4,12,2" />
                    <UniformGrid x:Name="MonthGrid" Grid.Row="2" Rows="6" Columns="7" Margin="12,0,12,8" Background="Transparent" />

                    <Border Grid.Row="3" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
                        <Grid Margin="20,12,10,4">
                            <TextBlock x:Name="AgendaTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="13" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="AgendaList" Margin="12,0,6,10" />
                    </ScrollViewer>
                </Grid>

                <!-- Settings -->
                <Grid x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
                        <Button x:Name="SettingsBack" Style="{StaticResource IconButton}" Content="&#xE72B;" />
                        <TextBlock x:Name="SettingsTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="20,0,16,16">
                            <TextBlock x:Name="AccountHeading" Style="{StaticResource SectionTitle}" Margin="0,10,0,2" />
                            <TextBlock x:Name="AccountStatus" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" />

                            <TextBlock x:Name="ClientIdLabel" Style="{StaticResource Label}" />
                            <TextBox x:Name="ClientIdBox" />
                            <TextBlock x:Name="ClientSecretLabel" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="ClientSecretBox" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="SignInButton" Style="{StaticResource AccentButton}" />
                                <Button x:Name="SignOutButton" Style="{StaticResource TextButton}" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock x:Name="HelpText" Foreground="{DynamicResource FgDim}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <Button x:Name="ConsoleLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,4,0,0" />

                            <TextBlock x:Name="CalendarsHeading" Style="{StaticResource SectionTitle}" />
                            <StackPanel x:Name="CalendarList" Margin="-8,2,0,0" />

                            <TextBlock x:Name="WeekStartHeading" Style="{StaticResource SectionTitle}" />
                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="1"
                                    HorizontalAlignment="Left" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="WeekStartAuto" Style="{StaticResource Segment}" GroupName="WeekStart" />
                                    <RadioButton x:Name="WeekStartSunday" Style="{StaticResource Segment}" GroupName="WeekStart" />
                                    <RadioButton x:Name="WeekStartMonday" Style="{StaticResource Segment}" GroupName="WeekStart" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
                    <Grid Margin="14,5,10,5" MinHeight="24">
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource FgFaint}" FontSize="11.5" VerticalAlignment="Center"
                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="ConnectButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: week or day time grid. Collapsed in month view. -->
            <Border x:Name="TimePanel" Grid.Column="1" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,12,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RangeTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="TodayButton" Grid.Column="1" Style="{StaticResource TextButton}" Margin="0,0,6,0" />
                        <Button x:Name="PreviousRange" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" />
                        <Button x:Name="NextRange" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" />
                    </Grid>

                    <Grid x:Name="DayHeaderGrid" Grid.Row="1" Margin="0,0,8,0" />

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1">
                        <ScrollViewer x:Name="BannerScroll" MaxHeight="92" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <Grid x:Name="BannerGrid" Margin="0,2,8,3" />
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer x:Name="TimeScroll" Grid.Row="3" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid x:Name="TimeGrid" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
